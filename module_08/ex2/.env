# .env files store local environment variables.
# Environment variables are commonly used to keep configuration
# values outside the source code.

# This is useful for:
# - API keys
# - database credentials
# - private URLs
# - development and production settings

# .env files should usually NOT be committed to Git.
# They are commonly added to .gitignore to protect secrets.

# python-dotenv reads this file and loads the values into the
# application environment.



# Current application mode.
# Common values: development, testing, production.
MATRIX_MODE=development


# Database connection address.
# This example uses a local SQLite database.
DATABASE_URL=sqlite:///local_matrix.db


# Secret API key used for authentication.
# Real API keys should never be shared publicly.
API_KEY=cerkurt2026codam


# Logging detail level.
# DEBUG shows more detailed information during development.
LOG_LEVEL=DEBUG


# Network endpoint used by the application.
# localhost means the service runs on the local machine.
ZION_ENDPOINT=http://localhost:8080/zion